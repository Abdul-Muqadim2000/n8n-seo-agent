# ---- SEO Agent credentials (copy these lines into n8n/.env and fill the values) -------------------------------------------
# n8n reads them through {{ $env.X }} expressions in its credential records (see seo-agent/sync_credentials.py).
# After editing .env:  cd n8n && docker compose up -d n8n     (recreate; a plain restart does not reload .env)
# To (re)create the credential records once:  python3 seo-agent/sync_credentials.py
SEO_BRAND=Dev SEO                              # shown on reports and e-mails
SEO_MAIL_FROM=Dev SEO <you@example.com>        # sender of every report e-mail (must be allowed by the SMTP account)
SEO_OPS_EMAIL=you@example.com                  # who gets the Error Handler alerts
SEO_DATAFORSEO_LOGIN=                          # app.dataforseo.com → API access: login (e-mail)
SEO_DATAFORSEO_PASSWORD=                       # and API password
SEO_JINA_API_KEY=                              # jina.ai API key (the header gets "Bearer " + key)
SEO_PAGESPEED_API_KEY=                         # Google Cloud API key with PageSpeed Insights API enabled
SEO_ANTHROPIC_API_KEY=                         # console.anthropic.com
SEO_FORM_USER=                                 # login for the public form
SEO_FORM_PASSWORD=
SEO_API_KEY=                                   # X-API-Key for /webhook/seo-keyword-check (any long random secret)
SEO_API_KEY_TEST=                              # X-API-Key for the Test Runner (testing only)
SEO_SMTP_HOST=smtp.gmail.com                   # report e-mails (port 465, SSL)
SEO_SMTP_USER=you@gmail.com
SEO_SMTP_PASSWORD=                             # Google App Password (Google Account → Security → 2-Step Verification → App passwords)
SEO_IMAP_HOST=imap.gmail.com                   # Console Alerts watcher (port 993, SSL); same Gmail + App Password
SEO_IMAP_USER=you@gmail.com
SEO_IMAP_PASSWORD=
SEO_GOOGLE_SA_EMAIL=                           # service account client_email (Search Console + GA4); add it as a user in both
SEO_GOOGLE_SA_PRIVATE_KEY=                     # service account private_key on ONE line with literal \n sequences (as in the JSON key file)
SEO_WORDPRESS_URL=                             # optional: WordPress drafts (sub-workflow, off by default)
SEO_WORDPRESS_USER=
SEO_WORDPRESS_APP_PASSWORD=
