import { launch, context, open } from './harness.mts';
const b = await launch();
const c = await context(b, { persona: 'owner', width: 1440, theme: 'light' });
const { page } = await open(c, '/o/org-1/sites/s-erp/keywords');
const labels = await page.locator('[data-ki-filters] label').allInnerTexts();
console.log('labels', labels.map((l) => l.split('\n')[0]));
const gi = labels.findIndex((l) => /gap|competitor/i.test(l.split('\n')[0]));
console.log('gapLabel', gi >= 0 ? labels[gi].slice(0, 300).replace(/\n/g, ' | ') : 'NONE');
const sel = page.locator('[data-ki-filters] select');
if (gi >= 0) { await sel.nth(gi).selectOption({ index: 1 }); await page.waitForTimeout(900);
  console.log('gapDesc', await page.getByText(/match your filters/).first().innerText().catch(() => ''), 'rows', await page.locator('table tbody tr').count(), await page.getByText(/^\d[\d,]*-\d[\d,]* of/).allInnerTexts());
  await page.locator('table').scrollIntoViewIfNeeded(); await page.screenshot({ path: '/out/pass2/x-kw-gapfilter-1440.jpg', type: 'jpeg', quality: 50 });
  await sel.nth(gi).selectOption(''); await page.waitForTimeout(500); }
await sel.nth(0).selectOption('gated'); await page.waitForTimeout(900);
console.log('tableGated', (await page.locator('table tbody tr td:nth-child(4)').allInnerTexts()).slice(0, 4));
console.log('topicGated', (await page.locator('ul [data-verdict=gated]').allInnerTexts()).slice(0, 2));
await sel.nth(0).selectOption('unknown'); await page.waitForTimeout(900);
console.log('tableUnknown', (await page.locator('table tbody tr').allInnerTexts()).slice(0, 2).map((t) => t.replace(/\n/g, ' | ')));
await page.locator('table').scrollIntoViewIfNeeded(); await page.screenshot({ path: '/out/pass2/x-kw-unknown-1440.jpg', type: 'jpeg', quality: 50 });
const p2 = await c.ctx.newPage(); await p2.goto('http://app.test' + (await import('./harness.mts')).sid('/o/org-1/sites/s-erp/competitors'), { waitUntil: 'networkidle' }); await p2.waitForTimeout(500);
const t = await p2.locator('main').innerText();
console.log('heroGaps', t.match(/Gaps to act on\s*\n\s*\d+/)?.[0], '| gapsPanel', t.match(/\d+ places where[^\n]*/)?.[0], '| listsLine', t.match(/[^\n]*Website settings[^\n]*/)?.[0]);
await c.ctx.close();
const m = await context(b, { persona: 'owner', width: 375, theme: 'light' });
const q = await open(m, '/o/org-1/sites/s-erp/keywords');
await q.page.getByRole('button', { name: /See every search/ }).click(); await q.page.waitForTimeout(600);
await q.page.getByRole('button', { name: /^Filters/ }).first().click(); await q.page.waitForTimeout(500);
await q.page.locator('[role=dialog] select').first().selectOption('gated'); await q.page.getByRole('button', { name: /Show results/ }).click(); await q.page.waitForTimeout(900);
console.log('cardsGated', (await q.page.locator('[data-table-cards] li').allInnerTexts()).slice(0, 2).map((t) => t.replace(/\n/g, ' | ')));
await m.ctx.close();
const pa = await context(b, { persona: 'padmin', width: 1440, theme: 'light' });
const g = await open(pa, '/o/org-1/sites/s-trial/settings/tracking');
const card = g.page.getByText('Competitors and Keyword research', { exact: true }).first();
await card.scrollIntoViewIfNeeded();
await g.page.getByRole('radio', { name: 'On' }).click().catch(async () => { await g.page.getByRole('button', { name: 'On', exact: true }).click(); });
await g.page.waitForTimeout(300);
const box = g.page.locator('main').getByText(/Compare the trial|switch.*On|client will see/i);
console.log('afterOnText', await box.allInnerTexts());
await g.page.getByRole('button', { name: 'Save', exact: true }).last().click(); await g.page.waitForTimeout(600);
console.log('dialogs', await g.page.locator('[role=dialog],[role=alertdialog]').allInnerTexts());
await g.page.screenshot({ path: '/out/pass2/g-switch-on-1440.jpg', type: 'jpeg', quality: 50 });
console.log('api', pa.apiLog.filter((x) => x.method !== 'GET').map((x) => `${x.method} ${x.path} ${x.status}`));
await b.close();
