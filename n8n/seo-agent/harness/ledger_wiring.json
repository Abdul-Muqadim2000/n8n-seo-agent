   "cost_basis": "={{ $json.cost_basis }}",
   "cost_mode": "={{ $json.cost_mode }}",
   "dfs_source": "={{ $json.dfs_source }}",
   "dfs_usd": "={{ $json.dfs_usd }}",
   "estimated_usd": "={{ $json.estimated_usd }}",
   "measured_usd": "={{ $json.measured_usd }}",
   "settled_at": "={{ $json.settled_at }}",
   "settled_usd": "={{ $json.settled_usd }}",
