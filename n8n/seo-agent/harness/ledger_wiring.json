    "dfs_usd": "={{ 0.04 }}",
    "estimated_usd": "={{ 0.04 }}",
    "measured_usd": "={{ 0 }}",
    "settled_at": "={{ new Date().toISOString() }}",
    "settled_usd": "={{ 0 }}",
    "status": "stale"
   }
  },
  "settle_conditions": [
   [
    "run_id",
    "={{ $execution.id }}"
   ],
   [
    "status",
    "reserved"
   ]
  ],
  "settle_from": [
