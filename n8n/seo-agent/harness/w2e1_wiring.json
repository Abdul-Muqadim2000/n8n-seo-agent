{
 "Trim Old Answer Text": {
  "executeOnce": true,
  "filters": {
   "conditions": [
    {
     "condition": "={{ (((t) => String(t.site_id || '').trim() || (String(t.domain || '').trim() ? 'site_' + String(t.domain).toLowerCase().trim().replace(/^https?:\\/\\//, '').replace(/^www\\./, '').replace(/[\\/?#].*$/, '').replace(/[^a-z0-9]+/g, '-') : '%'))(Object.assign({}, $('Manual Run').first().json || {}, ($('Manual Run').first().json || {}).body || {}))) === '%' ? 'like' : 'eq' }}",
     "keyName": "site_id",
     "keyValue": "={{ ((t) => String(t.site_id || '').trim() || (String(t.domain || '').trim() ? 'site_' + String(t.domain).toLowerCase().trim().replace(/^https?:\\/\\//, '').replace(/^www\\./, '').replace(/[\\/?#].*$/, '').replace(/[^a-z0-9]+/g, '-') : '%'))(Object.assign({}, $('Manual Run').first().json || {}, ($('Manual Run').first().json || {}).body || {})) }}"
    },
    {
     "condition": "neq",
     "keyName": "run_kind",
     "keyValue": "pulse"
    },
    {
     "condition": "lt",
     "keyName": "checked_at",
     "keyValue": "={{ new Date(Date.now() - 35 * 864e5).toISOString() }}"
    },
    {
     "condition": "gte",
     "keyName": "checked_at",
     "keyValue": "={{ new Date(Date.now() - 49 * 864e5).toISOString() }}"
    },
    {
     "condition": "isNotEmpty",
     "keyName": "answer_text",
     "keyValue": ""
    }
   ]
  },
  "from": [
   "Prune Old Answers"
  ],
  "onError": "continueRegularOutput",
  "operation": "update",
  "to": [
   "Trimmed (AI)"
  ],
  "values": {
   "answer_text": "",
   "retrieved_json": ""
  }
 },
