        "id": "72b66c08-d26b-570c-9015-c395c1afa412",
        "name": "Load Cache (Audit)",
        "type": "n8n-nodes-base.dataTable",
        "typeVersion": 1.1,
        "position": [
          1320,
          220
        ],
        "alwaysOutputData": true,
        "executeOnce": true,
        "onError": "continueRegularOutput"
