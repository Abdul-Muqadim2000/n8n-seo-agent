[
  {
    "id": "SEOagentTestRun1",
    "name": "SEO Agent — Test Runner",
    "active": false,
    "settings": {
      "executionOrder": "v1",
      "errorWorkflow": "SEOagentErrHandl",
      "executionTimeout": 1800,
      "saveDataErrorExecution": "all",
      "saveDataSuccessExecution": "all"
    },
    "tags": [],
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "seo-test-run",
          "authentication": "headerAuth",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "0c539824-3fec-575e-8b70-f0bc813b56f1",
        "name": "Test Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          0,
          0
        ],
        "webhookId": "3f1c8e2a-5b7d-5c4e-9a1f-7e2d4b6c8a01",
        "credentials": {
          "httpHeaderAuth": {
            "id": "SEOcredApiTest01",
            "name": "SEO API Key (test)"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "// body.workflow picks the target (default: SEO Agent v4); the rest of the body is forwarded like the API does.\nconst raw = $input.first().json || {}; const b = (raw.body && typeof raw.body === 'object') ? raw.body : {};\nconst target = String(b.workflow || 'SEOagentV4Full01');\nconst request_id = String(b.request_id || $execution.id);\nreturn [{ json: { target, request_id, forward: { headers: raw.headers || {}, body: { ...b, workflow: undefined, request_id, client_ip: 'test-runner' } } } }];"
        },
        "id": "ffea1bc0-04c6-5b97-b33e-3475839647f8",
        "name": "Route Test",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          240,
          0
        ]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ JSON.stringify({ status: 'started', target: $json.target, request_id: $json.request_id }) }}",
          "options": {
            "responseCode": 202
          }
        },
        "id": "cd0e4022-f5df-5084-ad77-48eaddfaafcb",
        "name": "Respond Started",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          480,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "return [{ json: $input.first().json.forward }];"
        },
        "id": "5d3768d0-7c52-573a-a51d-3aa9e86bd0c0",
        "name": "Prepare Forward",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          720,
          0
        ]
      },
      {
        "parameters": {
          "source": "database",
          "workflowId": {
            "__rl": true,
            "mode": "id",
            "value": "={{ $('Route Test').first().json.target }}"
          },
          "mode": "once",
          "options": {
            "waitForSubWorkflow": false
          }
        },
        "id": "a5f179a0-74f4-5af3-9b4a-31f52709abd0",
        "name": "Run Target",
        "type": "n8n-nodes-base.executeWorkflow",
        "typeVersion": 1.2,
        "position": [
          960,
          0
        ]
      },
      {
        "parameters": {
          "content": "## SEO Agent — Test Runner (testing only)\n`POST /webhook/seo-test-run` with header `X-API-Key` = credential **SEO API Key (test)**. Body: the normal API body plus optional `workflow` (default SEOagentV4Full01; `SEOagentTracker1` runs the rank tracker now). Answers 202 and starts the target in the background. It bypasses the API front door's Quick Validate on purpose. **Deactivate or delete after testing.**",
          "height": 200,
          "width": 760,
          "color": 3
        },
        "id": "e2ccea15-dc6d-5e02-b1a9-59aa7cfe8e07",
        "name": "Note",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          -40,
          -260
        ]
      }
    ],
    "connections": {
