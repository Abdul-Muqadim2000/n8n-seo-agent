# Copy to .env.prod and fill in. Keep out of version control.
N8N_VERSION=2.41.4
N8N_HOST=seo.yourcompany.com          # public hostname behind your TLS proxy (forms + webhooks + callbacks use it)
GENERIC_TIMEZONE=Asia/Dubai

# Generate once and never change: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=                    # openssl rand -hex 24
