# SEO platform settings. The secrets the n8n stack already uses (SEO_API_KEY, N8N_API_KEY, SEO_SMTP_*, SEO_MAIL_FROM,
# SEO_GOOGLE_SA_EMAIL / SEO_GOOGLE_SA_PRIVATE_KEY, SEO_BRAND) are read from ../n8n/.env — do not copy them here.

# Where people open the app (links in e-mails, Google sign-in redirect). Production: https://seo.yourdomain.com
APP_URL=http://localhost:4000
# Postgres password for the app database (compose.yml)
APP_DB_PASSWORD=change-me-please

# "Sign in with Google": create an OAuth client (Web application) in Google Cloud Console → APIs & Services → Credentials,
# authorised redirect URI = <APP_URL>/api/auth/google/callback (dev: http://localhost:5173/api/auth/google/callback). Empty = button hidden.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# People who see the platform admin area (all companies, budgets, disable), comma-separated
PLATFORM_ADMIN_EMAILS=
# Monthly estimated-spend cap of a new company (USD); owners and platform admins can change it
DEFAULT_MONTHLY_BUDGET_USD=25
# false = invitation-only sign-up
ALLOW_SIGNUP=true

# E-mail. Off for now: every result, report and alert is shown in the app only.
#   ENGINE_EMAILS  — n8n also e-mails reports (the app passes the user's address); off = n8n gets no address at all
#   ACCOUNT_EMAILS — the app sends verification / password-reset / invitation mails through SMTP; off = links are shown in the app
#                    (invitations: copy the link; forgotten passwords: the platform admin creates a reset link)
#   REQUIRE_EMAIL_VERIFICATION — defaults to ACCOUNT_EMAILS (nothing to confirm without e-mails)
ENGINE_EMAILS=false
ACCOUNT_EMAILS=false

# Abuse and spend limits (open sign-up without e-mail confirmation needs them)
MAX_COMPANIES_PER_USER=3
OWNER_BUDGET_MAX_USD=100
PLATFORM_DAILY_SPEND_USD=40
# behind a reverse proxy: the number of proxy hops in front of the app (1 for one nginx / load balancer); 0 = no proxy
TRUST_PROXY=0

# "Choose keywords for me" (Pipeline settings): every 6 hours the server starts the next recommended keyword ladder (easy or reachable
# for the site, no overlap, within the budget, at most one a week per website) for websites that switched it on, on the owner's
# behalf — real ladder runs (about $1.80 each). false = the setting is stored but nothing starts on its own (keep it off in development).
AUTO_START_LADDERS=false

# n8n as seen from the app container, and the app as seen from n8n (callbacks). Production: CALLBACK_BASE_URL must be https.
N8N_BASE_URL=http://host.docker.internal:5678
CALLBACK_BASE_URL=http://host.docker.internal:4000
# the n8n project that holds the SEO Agent's Data Tables (the app creates seo_ladder_settings there if it is missing)
N8N_PROJECT_ID=wo1WpMiHjdduGvfl
